<Window x:Class="egzaminwpf2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:egzaminwpf2"
        mc:Ignorable="d"
        x:ClassModifier="public"
        Title="MainWindow" Height="350" Width="400"
        Background="LightSlateGray">
    <StackPanel HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Imię:" Height="30" Margin="10,10,27,10" Padding="5" FontWeight="Bold"/>
            <TextBox x:Name="inputImie" Width="200" Height="30" Margin="10" x:FieldModifier="public"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Nazwisko:" Height="30" Margin="0,10,10,10" Padding="5" FontWeight="Bold"/>
            <TextBox x:Name="inputNazwisko" Width="200" Height="30" Margin="10" x:FieldModifier="public"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Wiek:" Height="30" Margin="10,10,23,10" Padding="5" FontWeight="Bold"/>
            <TextBox x:Name="inputWiek" Width="200" Height="30" Margin="10" TextChanged="InputWiek_TextChanged" x:FieldModifier="public"/>
        </StackPanel>
        <CheckBox x:Name="inputRegulamin" Content="Akceptuję regulamin" Margin="82,10,10,10" FontWeight="Bold" Checked="InputRegulamin_Click" Unchecked="InputRegulamin_Click" x:FieldModifier="public"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Podgląd" Width="100" Margin="20,10,20,10" Click="Podglad_Click"/>
            <Button Content="Wyczyść" Width="100" Margin="20,10,20,10" Click="Wyczysc_Click"/>
        </StackPanel>


        <Button Content="Wyslij" Width="130" Height="40" Margin="10" Click="Wyslij_Click" FontSize="16" FontWeight="Bold" x:Name="wyslij" IsEnabled="False" x:FieldModifier="public"/>
    </StackPanel>
</Window>
